---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { SITE } from "@config";
import resumePDF from "../assets/resume.pdf";

const title = "Resume";
---

<Layout title={`${title} | ${SITE.title}`}>
  <Header activeNav="resume" />
  <Breadcrumbs />
  <main id="main-content">
    <section class="mx-auto max-w-3xl px-4 pb-12 pt-6">
      <h1 class="text-2xl font-semibold sm:text-3xl mb-8">Resume</h1>
      
      <!-- Download Button -->
      <div class="mb-8">
        <a 
          href={resumePDF}
          download="resume-Sanket(DataEngineering).pdf"
          class="inline-flex items-center gap-2 rounded-lg bg-skin-accent px-4 py-2 text-skin-inverted hover:opacity-90 transition-opacity"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Download Resume PDF
        </a>
      </div>

      <!-- Summary Section -->
      <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-skin-accent">Summary</h2>
        <div class="text-skin-base leading-relaxed space-y-4">
          <p>
          I’m Sanket, a <b>Data Science master’s student</b> who enjoys turning complex problems into practical, data-driven solutions. My background spans analytics, engineering, automation, and business problem-solving across industries like logistics, healthcare, software, and renewable energy.
          </p>
          <p>
          I’m especially interested in building systems and workflows that make data more reliable, useful, and easier to act on.
          </p> 
        </div>
      </section>

      <!-- Experience Section -->
      <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-skin-accent">Experience</h2>

        <div class="space-y-6">
          <!-- Job 1 -->
          <div class="border-l-2 border-skin-line pl-4">
            <p class="text-sm text-skin-base opacity-80 mb-2">12/2025 - Present</p>
            <h3 class="text-lg font-semibold text-skin-base">Graduate Student Research Assistant | Bielefeld University, Bielefeld</h3>
            <ul class="list-disc list-inside space-y-1 text-skin-base">
              <li>Developed an automated R analysis pipeline for data preparation, validation, and statistical analysis, reducing analysis turnaround time by 95%.</li>
              <li>Analyze health-economic and healthcare-utilization data using descriptive statistics, correlation analysis, and regression modelling to support research evaluation and interpretation.</li>
              <li>Validate research datasets by investigating missing values, inconsistencies, plausibility issues, and unusual utilization patterns before downstream statistical analysis.</li>
              <li>Translate analytical findings into structured reports, evaluations, and analysis-ready datasets for researchers and project discussions.</li>
            </ul>
          </div>

          <!-- Job 2 -->
          <div class="border-l-2 border-skin-line pl-4">
            <p class="text-sm text-skin-base opacity-80 mb-2">08/2025 - 10/2025</p>
            <h3 class="text-lg font-semibold text-skin-base">Revenue Management Intern | Hapag-Lloyd AG, Hamburg</h3>
            <ul class="list-disc list-inside space-y-1 text-skin-base">
              <li>Analyzed commercial performance KPIs across 6 regions and 36 sub-regions, providing reporting insights for revenue-management and planning decisions.</li>
              <li>Automated and documented a recurring global data and reporting workflow, reducing reporting turnaround time by 92%.</li>
              <li>Reconciled commercial datasets and investigated inconsistencies to create reliable inputs for global budgeting and performance analysis.</li>
              <li>Translated requirements from cross-functional stakeholders into analytical reports and process improvements for recurring commercial-steering workflows.</li>
            </ul>
          </div>

          <!-- Job 3 -->
          <div class="border-l-2 border-skin-line pl-4">
            <p class="text-sm text-skin-base opacity-80 mb-2">06/2024 - 11/2024</p>
            <h3 class="text-lg font-semibold text-skin-base">Software Developer Engineer – Data And Analytics | NUIT Solutions, India</h3>
            <ul class="list-disc list-inside space-y-1 text-skin-base">
              <li>Designed and implemented an internal client-tracking application using Python and PostgreSQL, improving client-management efficiency and reducing processing time by 85%.</li>
              <li>Worked with internal departments and external clients to identify process bottlenecks, define data and system requirements, and translate business needs into technical solutions.</li>
            </ul>
          </div>

          <!-- Job 4 -->
          <div class="border-l-2 border-skin-line pl-4">
            <p class="text-sm text-skin-base opacity-80 mb-2">10/2023 - 06/2024</p>
            <h3 class="text-lg font-semibold text-skin-base">Data Analyst | PowerMitra CleanTech Pvt. Ltd., India</h3>
            <ul class="list-disc list-inside space-y-1 text-skin-base">
              <li>Automated the migration, tranformation and validation of 100K+ CRM records from HubSpot to Zoho, reducing migration time by 85% while achieving zero data loss.</li>
              <li>Developed a PyTorch-based image-processing pipeline to analyze rooftop imagery, estimate installable solar capacity, and automate quotation generation, reducing quotation turnaround time by 94%.</li>
              <li>Built and managed an AWS-based analytical data warehouse to centralize operational and commercial data for reporting and analysis.</li>
            </ul>
          </div>
        </div>
      </section>


      <!-- Certifications Section (Optional) -->
      <!-- <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-skin-accent">Certifications</h2>
        
        <ul class="space-y-2 text-skin-base">
          <li>• <b>Kubestronaut</b> - The Linux Foundation</li>
          <li>• <b>AWS Solutions Architect Associate</b> - AWS</li>
          <li>• <b>AWS Solutions Architect Associate</b> - AWS</li>
        </ul>
      </section>  -->

      <!-- Skills Section -->
      <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-skin-accent">Skills</h2>

        <div class="space-y-4">
          <div>
            <div class="flex flex-wrap gap-2">
              <span class="inline-block bg-skin-card px-3 py-1 rounded-full text-sm border border-skin-line">Python</span>
              <span class="inline-block bg-skin-card px-3 py-1 rounded-full text-sm border border-skin-line">SQL</span>
              <span class="inline-block bg-skin-card px-3 py-1 rounded-full text-sm border border-skin-line">R</span>
              <span class="inline-block bg-skin-card px-3 py-1 rounded-full text-sm border border-skin-line">Pandas</span>
              <span class="inline-block bg-skin-card px-3 py-1 rounded-full text-sm border border-skin-line">PostgreSQL</span>
              <span class="inline-block bg-skin-card px-3 py-1 rounded-full text-sm border border-skin-line">Power BI</span>
              <span class="inline-block bg-skin-card px-3 py-1 rounded-full text-sm border border-skin-line">Power Query</span>
              <span class="inline-block bg-skin-card px-3 py-1 rounded-full text-sm border border-skin-line">PySpark</span>
              <span class="inline-block bg-skin-card px-3 py-1 rounded-full text-sm border border-skin-line">Apache Spark</span>
              <span class="inline-block bg-skin-card px-3 py-1 rounded-full text-sm border border-skin-line">ETL/ELT</span>
              <span class="inline-block bg-skin-card px-3 py-1 rounded-full text-sm border border-skin-line">Data Warehousing</span>
              <span class="inline-block bg-skin-card px-3 py-1 rounded-full text-sm border border-skin-line">AWS</span>
              <span class="inline-block bg-skin-card px-3 py-1 rounded-full text-sm border border-skin-line">Databricks</span>
              <span class="inline-block bg-skin-card px-3 py-1 rounded-full text-sm border border-skin-line">Airflow</span>
              <span class="inline-block bg-skin-card px-3 py-1 rounded-full text-sm border border-skin-line">Docker</span>
              <span class="inline-block bg-skin-card px-3 py-1 rounded-full text-sm border border-skin-line">PyTorch</span>
              <span class="inline-block bg-skin-card px-3 py-1 rounded-full text-sm border border-skin-line">scikit-learn</span>
              <span class="inline-block bg-skin-card px-3 py-1 rounded-full text-sm border border-skin-line">Statistical Modelling</span>
              <span class="inline-block bg-skin-card px-3 py-1 rounded-full text-sm border border-skin-line">Regression Analysis</span>
              <span class="inline-block bg-skin-card px-3 py-1 rounded-full text-sm border border-skin-line">Machine Learning</span>
              <span class="inline-block bg-skin-card px-3 py-1 rounded-full text-sm border border-skin-line">Deep Learning</span>
              <span class="inline-block bg-skin-card px-3 py-1 rounded-full text-sm border border-skin-line">Image Processing</span>
              <span class="inline-block bg-skin-card px-3 py-1 rounded-full text-sm border border-skin-line">Plotly</span>
              <span class="inline-block bg-skin-card px-3 py-1 rounded-full text-sm border border-skin-line">Dash</span>
              <span class="inline-block bg-skin-card px-3 py-1 rounded-full text-sm border border-skin-line">Matplotlib</span>
              <span class="inline-block bg-skin-card px-3 py-1 rounded-full text-sm border border-skin-line">DuckDB</span>
              <span class="inline-block bg-skin-card px-3 py-1 rounded-full text-sm border border-skin-line">Parquet</span>
              <span class="inline-block bg-skin-card px-3 py-1 rounded-full text-sm border border-skin-line">SQLite</span>
            </div>
          </div>
        </div>
      </section>

      <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-skin-accent">LANGUAGES</h2>
        <div class="flex flex-wrap gap-2">
          <span class="inline-block bg-skin-card px-3 py-1 rounded-full text-sm border border-skin-line">English: Professional Proficiency</span>
          <span class="inline-block bg-skin-card px-3 py-1 rounded-full text-sm border border-skin-line">German: B1 (Actively Improving)</span>
        </div>
      </section>

      <!-- Education Section -->
      <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-skin-accent">Education</h2>
        
        <div class="space-y-4 mb-10">
          <div class="border-l-2 border-skin-line pl-4">
            <h3 class="text-lg font-semibold text-skin-base">M.Sc In Data Science</h3>
            <p class="text-sm text-skin-base opacity-80">
              Bielefeld University • Bielefeld, Germany • 2024-Current
            </p>
          </div>
        </div>
        <div class="space-y-4 mb-10">
          <div class="border-l-2 border-skin-line pl-4">
            <h3 class="text-lg font-semibold text-skin-base">B.Sc In Data Science</h3>
            <p class="text-sm text-skin-base opacity-80">
              Thakur College Of Science And Commerce • Mumbai, India • 2020-2023
            </p>
          </div>
        </div>
        
        
      </section>

    </section>
  </main>
  <Footer />
</Layout>
